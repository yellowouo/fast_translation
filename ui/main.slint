import { ScrollView } from "std-widgets.slint";

// ── Floating ball ────────────────────────────────────────────────
export component FloatingBall inherits Window {
    title: "Fast Translation";

    no-frame: true;
    always-on-top: true;
    width: 20px;
    height: 20px;
    background: transparent;
    in-out property <bool> visible-ball: true;
    callback hovered();
    callback clicked();

    if root.visible-ball: Rectangle {
        width: 14px; height: 14px; border-radius: 7px;
        background: @linear-gradient(135deg, #f0a4c4, #db5590);
        border-width: 1px; border-color: rgba(255, 255, 255, 0.18);
        x: 3px; y: 3px;
        drop-shadow-color: rgba(219, 85, 144, 0.45);
        drop-shadow-offset-y: 1px; drop-shadow-blur: 6px;
    }
    ball-area := TouchArea {
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
        clicked => { root.clicked(); }
    }
}

export component KeepAlive inherits Window {
    title: "Fast Translation";

    width: 0px;
    height: 0px;
    no-frame: true;
    background: transparent;
    always-on-top: true;
}

// ── 矢量图标（浅色单色风格，对应 style.jpg） ──
component SpeakerIcon inherits Rectangle {
    in property <brush> icon-color: #8b909a;
    width: 16px; height: 16px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M4 9.5 L8 9.5 L12.5 5 L12.5 19 L8 14.5 L4 14.5 Z";
        fill: parent.icon-color;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M15.5 9 A4.5 4.5 0 0 1 15.5 15";
        stroke: parent.icon-color;
        stroke-width: 1.8px;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M18 6.5 A8 8 0 0 1 18 17.5";
        stroke: parent.icon-color;
        stroke-width: 1.8px;
    }
}

component CopyIcon inherits Rectangle {
    in property <brush> icon-color: #8b909a;
    width: 16px; height: 16px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M9 8.5 H20 V19.5 H9 Z";
        stroke: parent.icon-color;
        stroke-width: 1.8px;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M5.5 15.5 V4.5 H16.5";
        stroke: parent.icon-color;
        stroke-width: 1.8px;
    }
}

component CloseIcon inherits Rectangle {
    in property <brush> icon-color: #8b909a;
    width: 10px; height: 10px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 10; viewbox-height: 10;
        commands: "M1.5 1.5 L8.5 8.5 M8.5 1.5 L1.5 8.5";
        stroke: parent.icon-color;
        stroke-width: 1.6px;
        stroke-line-cap: round;
    }
}

component CheckmarkIcon inherits Rectangle {
    in property <brush> icon-color: #ffffff;
    width: 10px; height: 10px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 12; viewbox-height: 12;
        commands: "M2.5 6.5 L4.8 9 L9.5 3";
        stroke: parent.icon-color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

